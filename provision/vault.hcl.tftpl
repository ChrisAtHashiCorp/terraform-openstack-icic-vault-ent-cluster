ui = true

disable_mlock = true

api_addr     = "https://${fqdn}:8200"
cluster_addr = "https://${fqdn}:8201"
license_path = "/opt/vault/vault.hclic"

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file   = "/opt/vault/tls/tls.crt"
  tls_key_file    = "/opt/vault/tls/tls.key"
}

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "${fqdn}"

  %{ for srvr in srvr_list }
  retry_join {
    leader_api_addr       = "https://${srvr}:8200"
    leader_ca_cert_file   = "/opt/vault/tls/ca.crt"
    leader_tls_servername = "${srvr}"
  }%{ endfor ~}

}
